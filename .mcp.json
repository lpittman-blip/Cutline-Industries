{
  "mcpServers": {
    "voice-print": {
      "type": "stdio",
      "command": "node",
      "args": ["tools/voice-print/mcp/server.js"],
      "env": {
        "VOICE_PRINT_PRINTER_IP": "192.168.1.157",
        "VOICE_PRINT_DEFAULT_FILE": "docs/combined-print.html"
      },
      "tools": ["print", "list_printables"]
    },
    "openaiDeveloperDocs": {
      "type": "http",
      "url": "https://developers.openai.com/mcp?source=cursor"
    },
    "codex": {
      "type": "stdio",
      "command": "node",
      "args": ["tools/codex-mcp/server.js"],
      "tools": ["codex_status", "codex_ask", "codex_review"]
    }
  }
}
