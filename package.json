{
  "name": "cutline-industries",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts server/*.test.ts server/**/*.test.ts tools/**/*.test.ts",
    "verify": "npm run lint && npm run typecheck && npm test",
    "preview": "vite preview",
    "api": "tsx --import ./server/instrument.ts server/api.ts",
    "autopilot": "tsx server/autopilot.ts",
    "autopilot:once": "tsx server/autopilot.ts --once",
    "ai:pipeline": "tsx server/aiAutopilot.ts",
    "ai:pipeline:once": "tsx server/aiAutopilot.ts --once",
    "auth:youtube": "tsx server/youtubeAuth.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "env:view": "tsx tools/cursor-env/cli.ts",
    "deploy": "bash scripts/cursor-deploy.sh",
    "deploy:push": "git push origin main && git push gitea main 2>/dev/null || true",
    "deploy:zip": "curl -sf -X POST https://cutline-industries.studio/_internal/gen-zip -H 'Content-Type: application/json' -H \"x-deploy-signature: sha256=$(echo -n '{}' | openssl dgst -sha256 -hmac ${DEPLOY_WEBHOOK_SECRET} -hex | awk '{print $2}')\" -d '{}' && echo 'ZIP triggered'",
    "start": "concurrently -k \"npm:api\" \"npm:dev\"",
    "artemis": "bun --cwd artemis-cli run src/cli.tsx",
    "artemis:test": "bun --cwd artemis-cli test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@sentry/node": "^10.70.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.3",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "ink": "^8.0.0",
    "mammoth": "^1.13.0",
    "openai": "^7.3.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.2.7",
    "react-router-dom": "7.18.2",
    "stripe": "^22.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "ink-testing-library": "^4.0.0",
    "oxlint": "^1.71.0",
    "sass": "^1.102.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
