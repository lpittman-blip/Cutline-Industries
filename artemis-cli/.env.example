# Artemis configuration. Export these in your shell or deployment; never commit real keys.
# (Bun auto-loads a local .env if you create one; it is gitignored.)

# ---- CLI → Artemis server (default connection) ------------------------------
# Usually set by `artemis login` (saved to ~/.artemis/config.json, mode 0600).
ARTEMIS_URL=http://127.0.0.1:7777
ARTEMIS_API_KEY=
# Model name sent to the server: "artemis" = server default, "artemis-mock" = offline mock
ARTEMIS_MODEL=artemis
ARTEMIS_MAX_STEPS=25
ARTEMIS_TOKEN_BUDGET=200000

# ---- Server → model provider (also used by `artemis --direct`) --------------
# Any OpenAI-compatible /chat/completions endpoint with tool calling.
ARTEMIS_PROVIDER_BASE_URL=https://api.x.ai/v1
ARTEMIS_PROVIDER_KEY=
ARTEMIS_PROVIDER_MODEL=grok-4-fast-non-reasoning
# Fallback key env vars, in order: XAI_API_KEY, OPENAI_API_KEY
# ARTEMIS_PROVIDER=mock      # serve the offline mock model instead

# Optional: forward chat to an existing Artemis core, used only if it answers GET /v1/models
# with an OpenAI-style model list (probed read-only at startup and on /v1/status).
ARTEMIS_CORE_URL=
ARTEMIS_CORE_KEY=

# ---- Server runtime ----------------------------------------------------------
HOST=127.0.0.1
PORT=7777
ARTEMIS_DATA_DIR=~/.artemis/server        # sqlite db lives here (artemis.db)
ARTEMIS_WORKSPACES_ROOT=.                 # agent runs/search may only touch dirs inside this
ARTEMIS_ALLOW_CLONE=0                     # 1 = allow {"repo": "https://..."} shallow clones
ARTEMIS_RATE_LIMIT=120                    # requests per minute per key
ARTEMIS_WEBHOOK_ATTEMPTS=5
ARTEMIS_WEBHOOK_RETRY_MS=2000             # exponential backoff base
ARTEMIS_PUBLIC_URL=                       # shown in OpenAPI servers[] and docs
ARTEMIS_BOOTSTRAP_KEY=                    # optional fixed first admin key (else one is generated and printed once)
