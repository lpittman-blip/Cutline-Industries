{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.cutline-industries.studio/api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://api.cutline-industries.studio/v1/:path*"
    },
    {
      "source": "/gateway/status",
      "destination": "https://api.artemisai-bycutlineindustries.studio/api/status"
    },
    {
      "source": "/gateway/health",
      "destination": "https://api.artemisai-bycutlineindustries.studio/api/health"
    }
  ]
}
