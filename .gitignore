# Logs
logs
*.log
!artemis-data/logs/
!artemis-data/logs/**
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# YouTube / Google secrets — never commit
client_secret.json
token.json
ramp_token.json
.env
.env.*
!.env.example
autopilot-state.json
autopilot.log
ai-pipeline-state.json
ai-pipeline.log
leads.json

# Artemis runtime hunts / knowledge attachments (keep seed files)
artemis-data/conversations/*
!artemis-data/conversations/.gitkeep
!artemis-data/conversations/conv_welcome.json
artemis-data/knowledge/*
!artemis-data/knowledge/.gitkeep
!artemis-data/knowledge/artemis.md
!artemis-data/knowledge/cutline.md
!artemis-data/knowledge/integrations.md
artemis-data/uploaded/*
!artemis-data/uploaded/.gitkeep
artemis-data/knowledge-index.json
# Runtime append-only log. Every test run and every request writes to it, so a
# tracked copy means a dirty tree after each run; ensureArtemisData() recreates
# the file when it is missing, so nothing needs the committed version.
artemis-data/logs/activity.jsonl
artemis-data/rag/*
!artemis-data/rag/.gitkeep
artemis-data/research/*
!artemis-data/research/.gitkeep
!artemis-data/research/landing-mockup.json
inbox/*
!inbox/.gitkeep
shorts_out/*
!shorts_out/.gitkeep
uploaded/*
!uploaded/.gitkeep
ai_out/
thermal_media/
*.zip
cutline-industries-web.zip

# Tool secrets
tools/*/secrets/
tools/*/.env
secrets/approval-pending/
secrets/approval-devices.json

# voice-print HTML→PDF scratch files (written next to source HTML)
**/.voice-print-*.pdf

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/mcp.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Cursor MCP secrets
